        {
          "atomType": "Code",
          "x": 0.8203,
          "y": 0.2629,
          "uniqueID": "id-125",
          "ioValues": [
            {
              "name": "shape",
              "ioValue": "__GEOMETRY_INPUT__"
            }
          ],
          "interpreterVersion": 1,
          "code": "function run(shape: Assembly) {\n  return shape.onLeafs((leaf) => {\n    const [[xMin, yMin, zMin], [xMax, yMax, zMax]] = leaf.geometry.boundingBox.bounds;\n    const midZ = (zMin + zMax) / 2;\n    const pad = 1;\n    const keep = replicad.makeBox(\n      [xMin - pad, yMin - pad, zMin - pad],\n      [xMax + pad, yMax + pad, midZ]\n    );\n    leaf.geometry = leaf.geometry.intersect(keep);\n    return leaf;\n  });\n}",
          "compiledCode": "\"use strict\";\nfunction run(shape) {\n    return shape.onLeafs((leaf) => {\n        const [[xMin, yMin, zMin], [xMax, yMax, zMax]] = leaf.geometry.boundingBox.bounds;\n        const midZ = (zMin + zMax) / 2;\n        const pad = 1;\n        const keep = replicad.makeBox([xMin - pad, yMin - pad, zMin - pad], [xMax + pad, yMax + pad, midZ]);\n        leaf.geometry = leaf.geometry.intersect(keep);\n        return leaf;\n    });\n}\n"
        },
        {
          "atomType": "Code",
          "x": 0.7253,
          "y": 0.3314,
          "uniqueID": "id-126",
          "ioValues": [
            {
              "name": "shape",

            },
            {
              "name": "minVolume",
              "ioValue": 0.0625,
              "currentEquation": "slice_thickness * slice_thickness * slice_thickness * 4"
            }
          ],
          "interpreterVersion": 1,
          "code": "function run(shape: Assembly, minVolume: number = 1) {\n  return shape.onLeafs((leaf) => {\n    if (leaf.is3D() && replicad.measureVolume(leaf.geometry) >= minVolume) {\n      return leaf;\n    }\n    if (leaf.is2D() && replicad.measureArea(leaf.geometry) >= minVolume) {\n      return leaf;\n    }\n    return undefined;\n  });\n}",
          "compiledCode": "\"use strict\";\nfunction run(shape, minVolume = 1) {\n    return shape.onLeafs((leaf) => {\n        if (leaf.is3D() && replicad.measureVolume(leaf.geometry) >= minVolume) {\n            return leaf;\n        }\n        if (leaf.is2D() && replicad.measureArea(leaf.geometry) >= minVolume) {\n            return leaf;\n        }\n        return undefined;\n    });\n}\n"
        },
